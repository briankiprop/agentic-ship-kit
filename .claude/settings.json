{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git checkout -b *)",
      "Bash(python3 tests/test_template_structure.py)",
      "Bash(./scripts/run-quality-gates.sh)",
      "Bash(bash scripts/checkpoint.sh)",
      "Bash(npm test *)",
      "Bash(pnpm test *)",
      "Bash(yarn test *)",
      "Bash(pytest *)",
      "PowerShell(Start-Sleep -Seconds 10; $log = \"$env:USERPROFILE\\\\.agentic-ship-runs\\\\2026-06-18-195727-add-registration-page.log\"; $f = Get-Item $log; Write-Host \"Size: $\\($f.Length\\)\"; Get-Content $log; Write-Host \"---LOCK---\"; Get-Content \"$env:USERPROFILE\\\\.agentic-ship-running.pid\" -ErrorAction SilentlyContinue; Write-Host \"---CLAUDE---\"; Get-Process claude -ErrorAction SilentlyContinue | Select-Object Id, CPU, StartTime)",
      "PowerShell(Get-Process -Name bash,claude -ErrorAction SilentlyContinue)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Read(./**/id_rsa)",
      "Read(./**/id_ed25519)",
      "Bash(git push origin main*)",
      "Bash(git push origin master*)",
      "Bash(git commit --no-verify*)",
      "Bash(rm -rf / *)",
      "Bash(curl * | sh*)",
      "Bash(wget * | sh*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(npm install *)",
      "Bash(pnpm add *)",
      "Bash(yarn add *)",
      "Bash(pip install *)",
      "Bash(poetry add *)",
      "Bash(brew install *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/checkpoint.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash scripts/notify-telegram.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
