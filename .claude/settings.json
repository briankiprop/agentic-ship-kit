{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Read(./**/id_rsa)",
      "Read(./**/id_ed25519)",
      "Bash(git push origin main*)",
      "Bash(git push origin master*)",
      "Bash(git commit --no-verify*)",
      "Bash(rm -rf / *)",
      "Bash(curl * | sh*)",
      "Bash(wget * | sh*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(npm install *)",
      "Bash(pnpm add *)",
      "Bash(yarn add *)",
      "Bash(pip install *)",
      "Bash(poetry add *)",
      "Bash(brew install *)"
    ],
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git checkout -b *)",
      "Bash(python3 tests/test_template_structure.py)",
      "Bash(./scripts/run-quality-gates.sh)",
      "Bash(bash scripts/checkpoint.sh)",
      "Bash(npm test *)",
      "Bash(pnpm test *)",
      "Bash(yarn test *)",
      "Bash(pytest *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "bash scripts/checkpoint.sh", "timeout": 5 },
          { "type": "command", "command": "bash scripts/notify-telegram.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
